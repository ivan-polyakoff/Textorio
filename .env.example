VK_GROUP_TOKEN=your_vk_group_token_here
GROUP_ID=your_group_id_here
GIGACHAT_API_KEY=your_gigachat_api_key_here
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_FILES_URL=https://gigachat.devices.sberbank.ru/api/v1/files
GIGACHAT_TEXT_MODEL=GigaChat
GIGACHAT_VISION_MODEL=GigaChat-Pro
GIGACHAT_TIMEOUT_MS=30000
GIGACHAT_RETRY_ATTEMPTS=3
VK_PHOTO_DOWNLOAD_TIMEOUT_MS=30000
# Path to a PEM/CRT bundle with trusted root certificates, if Node.js cannot validate GigaChat TLS certificates.
# GIGACHAT_CA_BUNDLE_FILE=certs/russian-trusted-root.pem
# Use only for local diagnostics if you do not have the CA bundle yet.
# GIGACHAT_REJECT_UNAUTHORIZED=false
PORT=3000
