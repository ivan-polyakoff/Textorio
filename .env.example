VK_GROUP_TOKEN=your_vk_group_token_here
GROUP_ID=your_group_id_here
GIGACHAT_API_KEY=your_gigachat_api_key_here
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_FILES_URL=https://gigachat.devices.sberbank.ru/api/v1/files
GIGACHAT_TEXT_MODEL=GigaChat
GIGACHAT_VISION_MODEL=GigaChat-Pro
# GIGACHAT_API_PERS — для личного ключа, GIGACHAT_API_B2B / GIGACHAT_API_CORP — для корпоративного
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_TIMEOUT_MS=30000
GIGACHAT_RETRY_ATTEMPTS=3
VK_PHOTO_DOWNLOAD_TIMEOUT_MS=30000
# Maximum photo size in MB that the bot will accept (larger photos are rejected with a friendly message)
VK_PHOTO_MAX_SIZE_MB=5
# Bot character: hedgehog (default) or dao_monk — see src/config/persona.js
BOT_PERSONA=hedgehog
# AI provider: gigachat (default) or openai (any OpenAI-compatible API)
AI_PROVIDER=gigachat
# --- openai-compatible provider (AI_PROVIDER=openai) ---
# Base URL without trailing slash, e.g.:
#   YandexGPT: https://llm.api.cloud.yandex.net/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama local: http://localhost:11434/v1
# AI_BASE_URL=https://api.example.ai/v1
# AI_API_KEY=your_api_key_here
# AI_MODEL=yandexgpt
# AI_VISION_MODEL=yandexgpt
# AI_TIMEOUT_MS=30000
# AI_RETRY_ATTEMPTS=3
# AI_CA_BUNDLE_FILE=certs/russian-trusted-root.pem
# AI_REJECT_UNAUTHORIZED=false
# Path to a PEM/CRT bundle with trusted root certificates, if Node.js cannot validate GigaChat TLS certificates.
# GIGACHAT_CA_BUNDLE_FILE=certs/russian-trusted-root.pem
# Use only for local diagnostics if you do not have the CA bundle yet.
# GIGACHAT_REJECT_UNAUTHORIZED=false
PORT=3000
# Каталог логов (по умолчанию logs/ внутри каталога приложения).
# Задавайте свой для каждого инстанса, если они делят один чекаут или
# хотите собирать логи вне каталога приложения: LOG_DIR=/var/log/textorio/prod
# LOG_DIR=
