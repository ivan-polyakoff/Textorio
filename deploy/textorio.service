[Unit]
Description=Textorio VK bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Пользователь, под которым работает бот (создайте: sudo useradd -r -s /usr/sbin/nologin textorio)
User=textorio
Group=textorio
# Путь к чекауту репозитория на сервере
WorkingDirectory=/opt/textorio
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

# Журнал: journalctl -u textorio -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
